# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 절대 공유하지 마세요)

# 카카오 계정 (티스토리 로그인용)
KAKAO_ID=your-kakao-id@example.com
KAKAO_PW=your-password

# 티스토리 블로그 주소의 앞부분.  myblog.tistory.com 이면 myblog
# config.json 의 blog.name 보다 우선 적용됩니다.
TISTORY_BLOG=

# 발행할 카테고리 이름 (비우면 카테고리 미지정)
TISTORY_CATEGORY=

# ── 네이버 블로그 ─────────────────────────────────────────────────────────
# 네이버는 로그인 자동화 탐지가 티스토리보다 강합니다. 틀린그림찾기나 2단계 인증이 뜨면
# `npm run login:naver` 를 실행해 열린 브라우저에서 한 번 직접 통과시켜야 합니다.
# 그 뒤에는 profile/session-naver.json 에 쿠키가 남아 무인 실행이 됩니다.
NAVER_ID=
NAVER_PW=

# blog.naver.com/myblog 이면 myblog.  비워 두면 login:naver 가 찾아서 채웁니다.
NAVER_BLOG=

# 발행할 게시판(카테고리) 이름
NAVER_CATEGORY=

# ── 무료 이미지 API 키 (전부 선택 사항, 전부 무료) ─────────────────────────
# 하나라도 넣으면 사진 확보가 몇 분 → 몇 초로 줄고 성공률이 크게 올라갑니다.
# 아무것도 없으면 codex 웹 검색 + Openverse 로만 찾습니다 (느리고 가끔 실패).
#
#   Pexels   https://www.pexels.com/api/          가입 즉시 발급, 200req/시
#   Unsplash https://unsplash.com/developers      앱 등록 후 Access Key, 50req/시
#   Pixabay  https://pixabay.com/api/docs/        가입 즉시 발급
#
# 인물(연예인) 사진은 위키미디어 공용에서 가져오며 키가 필요 없습니다.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# 1 로 두면 상세 디버그 로그 출력
MONEYTI_VERBOSE=0

# ── 틀린그림찾기(DKAPTCHA) ────────────────────────────────────────────────
# 연속 발행이 잦으면 티스토리가 지도 문제를 띄운다. 발행은 이 화면을
# 인식 → 입력 → 제출까지 스스로 처리하고(src/wrongPicture.js), 못 풀면 사람을 기다린다.
#
#   MONEYTI_SEC_ATTEMPTS         자동 판독 시도 횟수 (기본 3, 0 이면 자동 판독 끔)
#   MONEYTI_SEC_MIN_CONFIDENCE   이 확신 미만이면 답을 넣지 않는다 (기본 0.35)
#   MONEYTI_SEC_TIMEOUT_MS       판독 한 번의 제한 시간 (기본 180000)
#   MONEYTI_SEC_SUBMIT           enter 로 두면 "답변 제출" 버튼 대신 Enter 로만 제출
#   MONEYTI_WRONG_PICTURE_WAIT   자동 판독이 실패한 뒤 사람을 기다리는 초 (최대 900)
#                                없으면 --show 로 창이 떠 있을 때만 600초
#
# 시도가 잦으면 카카오가 위젯 자체를 막는다 (iframe 이 Bad Request). 지도도 입력칸도
# 없어 사람도 풀 수 없으므로 기다리지 않고, 레이어를 닫고 쉰 뒤 발행을 다시 누른다.
#
#   MONEYTI_SEC_BROKEN_RETRY     열리지 못한 위젯 재시도 횟수 (기본 2)
#   MONEYTI_SEC_BROKEN_WAIT      첫 재시도까지 기다리는 초 (기본 300 — 5분, 다음은 10분)
