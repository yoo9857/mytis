# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 절대 공유하지 마세요)

# 카카오 계정 (티스토리 로그인용)
KAKAO_ID=your-kakao-id@example.com
KAKAO_PW=your-password

# 티스토리 블로그 주소의 앞부분.  myblog.tistory.com 이면 myblog
# config.json 의 blog.name 보다 우선 적용됩니다.
TISTORY_BLOG=

# 발행할 카테고리 이름 (비우면 카테고리 미지정)
TISTORY_CATEGORY=

# ── 무료 이미지 API 키 (전부 선택 사항, 전부 무료) ─────────────────────────
# 하나라도 넣으면 사진 확보가 몇 분 → 몇 초로 줄고 성공률이 크게 올라갑니다.
# 아무것도 없으면 codex 웹 검색 + Openverse 로만 찾습니다 (느리고 가끔 실패).
#
#   Pexels   https://www.pexels.com/api/          가입 즉시 발급, 200req/시
#   Unsplash https://unsplash.com/developers      앱 등록 후 Access Key, 50req/시
#   Pixabay  https://pixabay.com/api/docs/        가입 즉시 발급
#
# 인물(연예인) 사진은 위키미디어 공용에서 가져오며 키가 필요 없습니다.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# 1 로 두면 상세 디버그 로그 출력
MONEYTI_VERBOSE=0
