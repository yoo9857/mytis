node_modules/
profile/
logs/
.tmp/

# 초안·렌더 결과는 버리지만 **사람이 눈으로 고른 사진은 남긴다.**
# 아티클 JSON 의 photoDir 이 이 폴더를 가리키므로, 커밋하지 않으면 다른 기기에서
# 같은 JSON 으로 발행할 때 사진이 통째로 바뀐다 (2026-08-03 발견).
# 큐레이션은 발행물의 일부다 — 초안과 함께 버릴 것이 아니다.
out/*
!out/photos/
# out/photos 바로 아래의 낱개 파일은 파이프라인이 받아 둔 **스톡 캐시**다(bg1.jpeg…).
# 사람이 고른 사진은 항상 글별 **하위 폴더**에 있으므로 폴더만 추적한다.
out/photos/*
!out/photos/*/
.env
topics.done.txt
topics.failed.txt
