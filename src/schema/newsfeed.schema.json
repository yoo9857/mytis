{
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "description": "블로그 소재로 쓸 만한 최신 기사 목록. 화제성이 높은 순으로 정렬.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "publisher", "publishedAt", "summary", "angle", "heatScore"],
        "properties": {
          "title": { "type": "string", "description": "기사 제목." },
          "url": {
            "type": "string",
            "description": "기사 원문 URL. 검색으로 실제 확인한 주소만. 지어내지 말 것."
          },
          "publisher": { "type": "string", "description": "매체명. 예: iMBC 연예, 스포츠조선." },
          "publishedAt": {
            "type": "string",
            "description": "보도 시각. YYYY-MM-DD 또는 YYYY-MM-DD HH:MM. 모르면 빈 문자열."
          },
          "summary": { "type": "string", "description": "무슨 내용인지 한국어 2문장 요약." },
          "angle": {
            "type": "string",
            "description": "이 소재로 블로그 글을 쓴다면 어떤 각도로 풀지 한 문장. 원 기사에 없는 부가가치를 제시할 것."
          },
          "heatScore": {
            "type": "integer",
            "description": "검색 수요와 화제성 추정치 1~100. 이미 포화된 주제는 낮게, 막 뜨는 주제는 높게."
          }
        }
      }
    }
  }
}
